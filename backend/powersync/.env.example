# Copia este archivo a .env (gitignorado) y completa los valores reales.
# Ver ../POWERSYNC.md para el detalle de cómo obtener cada uno.

# Puerto donde el servicio PowerSync expone su API/endpoint de sincronización.
PS_PORT=8080

# Conexión de PowerSync al Postgres de negocio (gi_control_combustible), que
# hoy vive en Railway, no en un Postgres local — por eso este compose usa la
# red bridge normal (no network_mode: host, que solo tendría sentido si el
# origen fuera un Postgres corriendo en el mismo host). Usa el rol
# powersync_role creado con ../sql/prepare-source-db.sql (solo lectura +
# replicación, nunca el usuario de la app gi_app). Evita passwords con "/" o
# "+": rompen el parseo de esta URI (usa hex, no base64, para generarla).
# El sslmode (verify-ca) no va en esta URI: ya está fijo en config/service.yaml
# junto con PS_PG_CACERT (ver más abajo y POWERSYNC.md sección 5) — Railway
# sirve TLS con un certificado autofirmado.
PS_DATA_SOURCE_URI=postgresql://powersync_role:CAMBIA-ESTA-PASSWORD@CAMBIA-ESTE-HOST.proxy.rlwy.net:CAMBIA-ESTE-PUERTO/railway

# Postgres dedicado (contenedor pg-storage) solo para el bucket storage
# interno de PowerSync. No es la base de negocio. Publicado en
# 127.0.0.1:PG_STORAGE_PORT para que powersync (network_mode: host) lo
# alcance ahí en vez de por nombre de servicio.
PG_STORAGE_USER=powersync_storage
PG_STORAGE_PASSWORD=CAMBIA-ESTA-PASSWORD
PG_STORAGE_DB=powersync_storage
PG_STORAGE_PORT=5433

# Mismo secreto HS256 que backend/.env JWT_SECRET, pero codificado en
# base64url (PowerSync espera el shared secret como JWK tipo "oct"):
#   printf '%s' "$JWT_SECRET" | base64 -w 0 | tr '+/' '-_' | tr -d '='
PS_JWT_SECRET_B64URL=CAMBIA-ESTO

# Debe coincidir con backend/.env POWERSYNC_JWT_KID.
PS_JWT_KID=gi-backend-hs256-v1

# CA autofirmada que sirve el Postgres de Railway (no valida contra las CAs
# del sistema, por eso hay que fijarla explícitamente). Necesaria para usar
# sslmode: verify-ca en vez de disable contra PS_DATA_SOURCE_URI cuando este
# apunta a Railway. Ver "Fuente de datos en Railway" en POWERSYNC.md para
# cómo obtenerla y por qué es segura (certificate pinning) aunque sea
# self-signed. Formato: el PEM completo en una sola línea con \n literales
# dentro de comillas dobles (así lo interpreta el parser de env de Compose).
# Para regenerarla:
#   openssl s_client -starttls postgres -connect <host-de-railway>:<puerto> \
#     -showcerts </dev/null 2>/dev/null | \
#     awk '/BEGIN CERT/{c++} c==2{print} /END CERT/ && c==2{exit}'
# (el segundo certificado de la cadena es la CA raíz autofirmada; el primero
# es el certificado hoja del servidor, que verify-ca no necesita fijar).
PS_PG_CACERT="CAMBIA-ESTO-PEGA-EL-CERTIFICADO-CON-\n-LITERALES"
