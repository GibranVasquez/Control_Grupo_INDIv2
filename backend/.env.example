DATABASE_URL="postgresql://user:password@localhost:5432/gi_control_combustible?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"
PORT=4000
NODE_ENV=development

# Origen permitido para CORS (la app frontend). En desarrollo, usa el host:puerto
# donde corre tu app (ej. http://localhost:3000). No usar "*" en producción.
ALLOWED_ORIGIN="http://localhost:PUERTO"

# Opcionales: solo se usan para que el JWT que emite este backend también sea
# válido para PowerSync (self-hosted, ver backend/powersync/POWERSYNC.md).
# Deben coincidir EXACTAMENTE con los mismos valores en backend/powersync/.env
# (client_auth.jwks.keys[].kid y client_auth.audience). Si se dejan vacíos, el
# login sigue funcionando igual, solo que el token no sería aceptado por PowerSync.
POWERSYNC_JWT_AUDIENCE="gi-control-combustible-powersync"
POWERSYNC_JWT_KID="gi-backend-hs256-v1"

# Opcional: DSN de un proyecto de Sentry (sentry.io o self-hosted) para recibir
# errores inesperados en producción. Si se deja vacío, el SDK queda
# deshabilitado (no manda nada, sin costo de rendimiento) — ver config/sentry.ts.
SENTRY_DSN=""
